# 复制为 .env 后按需修改；服务与评测都读这些环境变量
# 优先级：终端 export 的环境变量 > .env 文件

# 方式 A（最简）：只填这一个，自动使用 DeepSeek
# DEEPSEEK_API_KEY=sk-xxxxxxxx

# 方式 B：任意 OpenAI 兼容接口（本地 vLLM / 云端 / 合并后的模型服务）
LLM_API_BASE=http://127.0.0.1:8001/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# vLLM 服务（run_eval.py --generator vllm 用）
VLLM_API_BASE=http://127.0.0.1:8000/v1
VLLM_MODEL=lora-v1

PYTHONIOENCODING=utf-8
