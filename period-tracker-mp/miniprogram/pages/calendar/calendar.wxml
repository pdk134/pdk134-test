<import src="../../templates/task-row.wxml" />

<view class="page {{theme === 'dark' ? 'theme-dark' : ''}}">

  <!-- 日历 -->
  <view class="card">
    <view class="cal-head">
      <view class="nav-btn" bindtap="prevMonth">‹</view>
      <picker mode="date" fields="month" value="{{pickerValue}}" bindchange="onPickMonth">
        <view class="month-title">{{monthTitle}} ▾</view>
      </picker>
      <view class="nav-btn" bindtap="nextMonth">›</view>
    </view>
    <view class="week-row">
      <view wx:for="{{weekNames}}" wx:key="*this" class="week-cell">{{item}}</view>
    </view>
    <view class="cal-grid">
      <view wx:for="{{blanks}}" wx:key="*this" class="cal-empty"></view>
      <view wx:for="{{days}}" wx:key="date" class="cal-cell {{item.cls}}"
            data-date="{{item.date}}" bindtap="selectDate">
        <text class="cal-num">{{item.num}}</text>
        <text wx:if="{{item.badge}}" class="cal-badge">{{item.badge}}</text>
        <text wx:elif="{{item.dot}}" class="cal-dot"></text>
      </view>
    </view>
  </view>

  <!-- 当天任务 -->
  <view class="card">
    <view class="row between">
      <text class="day-title">{{dayTitle}}</text>
    </view>
    <view wx:if="{{dayCount}}" class="day-meta">
      <view class="day-count">{{dayCount}}</view>
      <view class="swipe-tip">← 左滑任务可编辑、推迟或删除</view>
    </view>
    <view class="task-list">
      <block wx:for="{{dayTasks}}" wx:key="id">
        <template is="swipeTaskRow" data="{{...item, deferForId: deferForId, deferDays: deferDays, editingId: editingId, editingText: editingText}}" />
      </block>
      <view wx:if="{{dayTasks.length === 0}}" class="empty-hint">这一天还没有任务</view>
    </view>
    <view class="quick-add">
      <input class="quick-input" value="{{quickValue}}" placeholder="添加这一天的待办，回车/点＋"
             confirm-type="done" bindinput="onQuickInput" bindconfirm="quickAdd" />
      <picker mode="time" value="{{quickTime || '09:00'}}" bindchange="onQuickTime">
        <view class="quick-time {{quickTime ? '' : 'empty'}}">{{quickTime || '设时间'}}</view>
      </picker>
      <view class="add-btn" bindtap="quickAdd">＋</view>
    </view>
    <view wx:if="{{quickTime}}" class="quick-before">
      <picker range="{{beforeLabels}}" value="{{beforeIndex}}" bindchange="onQuickBefore">
        <view class="quick-before-pill">{{beforeLabels[beforeIndex]}} ▾</view>
      </picker>
      <text class="quick-before-tip">选「到点提醒」则准点提醒</text>
    </view>
  </view>

</view>

<task-editor visible="{{editorVisible}}" task="{{editorTask}}" default-date="{{editorDate}}"
             bind:confirm="onEditorConfirm" bind:cancel="onEditorCancel" />
