<view class="page {{theme === 'dark' ? 'theme-dark' : ''}}">

  <view class="panel-card">
    <view class="section-title">☁️ 同步状态</view>
    <view class="acct-status">任务清单：{{syncText}}</view>
    <view class="acct-status">月记：{{periodSyncText}}</view>
    <view class="acct-status">{{openidShort}} · 本机 {{taskCount}} 条任务 / {{periodCount}} 段经期</view>
  </view>

  <view class="panel-card">
    <view class="section-title">🌗 外观</view>
    <view class="theme-row">
      <text>深色模式</text>
      <view class="switch-btn" bindtap="toggleTheme">{{theme === 'dark' ? '已开启' : '已关闭'}}</view>
    </view>
  </view>

  <view class="panel-card">
    <view class="section-title">⏰ 待办提醒</view>
    <view class="theme-row">
      <text>提前 1 天提醒</text>
      <view class="switch-btn" bindtap="toggleRemind">{{remindEnabled ? '已开启' : '已关闭'}}</view>
    </view>
    <view class="acct-status">新建任务时申请微信通知授权；一次性订阅，授权一次可接收一条提醒</view>
    <view class="action-btn" bindtap="sendTestRemind">
      发送测试提醒
      <text class="sub">从小程序内触发，立即给自己发一条</text>
    </view>
  </view>

  <view class="panel-card">
    <view class="section-title">ℹ️ 关于</view>
    <view class="action-btn" bindtap="goAbout">
      关于本小程序
      <text class="sub">功能说明、常见问题与意见反馈</text>
    </view>
  </view>

</view>
