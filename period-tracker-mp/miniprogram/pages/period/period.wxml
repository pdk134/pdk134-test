<view class="page {{theme === 'dark' ? 'theme-dark' : ''}}">

  <!-- 顶部分段 -->
  <view class="seg-bar">
    <view class="seg-item {{tab === 'calendar' ? 'on' : ''}}" data-tab="calendar" bindtap="switchTab">日历</view>
    <view class="seg-item {{tab === 'stats' ? 'on' : ''}}" data-tab="stats" bindtap="switchTab">统计</view>
  </view>

  <block wx:if="{{tab === 'calendar'}}">
    <!-- ========== 日历 ========== -->
    <view class="card status-card">
      <view class="status-main">{{statusMain}}</view>
      <view class="status-sub">{{statusSub}}</view>
      <view wx:if="{{statusTag}}" class="phase-tag">{{statusTag}}</view>
    </view>

    <view class="card">
      <view class="cal-head">
        <view class="nav-btn" bindtap="prevMonth">‹</view>
        <picker mode="date" fields="month" value="{{pickerValue}}" bindchange="onPickMonth">
          <view class="month-title">{{monthTitle}} ▾</view>
        </picker>
        <view class="nav-btn" bindtap="nextMonth">›</view>
      </view>
      <view class="week-row">
        <view wx:for="{{weekNames}}" wx:key="*this" class="week-cell">{{item}}</view>
      </view>
      <view class="cal-grid">
        <view wx:for="{{blanks}}" wx:key="*this" class="cal-empty"></view>
        <view wx:for="{{days}}" wx:key="date" class="cal-cell {{item.cls}}"
              data-date="{{item.date}}" bindtap="selectDate">
          <text class="cal-num">{{item.num}}</text>
          <text wx:if="{{item.dot}}" class="cal-log-dot"></text>
        </view>
      </view>
      <view class="legend">
        <view class="legend-item"><view class="lg-box is-period"></view>经期</view>
        <view class="legend-item"><view class="lg-box is-ongoing"></view>延续预测</view>
        <view class="legend-item"><view class="lg-box is-predicted"></view>下次预测</view>
        <view class="legend-item"><view class="lg-box is-fertile"></view>易孕期</view>
        <view class="legend-item"><view class="lg-box is-ovulation"></view>排卵日</view>
      </view>
      <view class="tip">点日历里的某一天，就在下方标记经期、记录症状心情</view>
    </view>

    <!-- ========== 当天操作（跟着选中的日期走） ========== -->
    <view class="card day-panel">
      <view class="period-toggle {{isPeriod ? 'on' : ''}}" bindtap="togglePeriod">{{periodBtnText}}</view>
      <view wx:if="{{showEndBtn}}" class="period-end {{endClosed ? 'closed' : ''}}" bindtap="toggleEnd">{{endBtnText}}</view>

      <view class="section-title">症状</view>
      <view class="chip-grid">
        <view wx:for="{{symptoms}}" wx:key="id" class="chip {{item.on ? 'on' : ''}}"
              data-id="{{item.id}}" bindtap="toggleSymptom">{{item.label}}</view>
      </view>

      <view class="section-title">心情</view>
      <view class="mood-row">
        <view wx:for="{{moods}}" wx:key="id" class="mood-btn {{item.on ? 'on' : ''}}"
              data-id="{{item.id}}" bindtap="setMood">
          <view class="mood-emoji">{{item.emoji}}</view>
          <view class="mood-label">{{item.label}}</view>
        </view>
      </view>

      <view class="section-title">备注</view>
      <textarea class="note-input" value="{{note}}" placeholder="今天想记录点什么…"
                maxlength="500" bindinput="onNoteInput" bindblur="flushNote" auto-height />
      <view class="save-hint {{savedHint ? 'show' : ''}}">已自动保存 ✓</view>
    </view>
  </block>

  <block wx:if="{{tab === 'stats'}}">
    <!-- ========== 统计 ========== -->
    <view class="stat-row">
      <view class="stat-card"><text class="num">{{avgCycle}}</text><text class="label">平均周期(天)</text></view>
      <view class="stat-card"><text class="num">{{avgPeriodLen}}</text><text class="label">平均经期(天)</text></view>
      <view class="stat-card"><text class="num">{{periodCount}}</text><text class="label">记录次数</text></view>
    </view>

    <view wx:if="{{alertTitle}}" class="card alert-card {{alertLevel}}">
      <view class="alert-title">{{alertTitle}}</view>
      <view class="alert-desc">{{alertDesc}}</view>
    </view>

    <view class="card next-card">
      <view class="next-title">{{nextTitle}}</view>
      <view class="next-date">{{nextDate}}</view>
      <view class="next-sub">{{nextSub}}</view>
    </view>

    <view class="card">
      <view class="section-title">近 6 次周期长度</view>
      <view wx:if="{{bars.length === 0}}" class="chart-empty">{{chartEmpty}}</view>
      <view wx:else class="bar-chart">
        <view wx:for="{{bars}}" wx:key="key" class="bar-item">
          <text class="bar-value">{{item.len}}</text>
          <view class="bar-track"><view class="bar" style="height:{{item.h}}%"></view></view>
          <text class="bar-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="section-title">经期历史</view>
      <view wx:if="{{history.length === 0}}" class="empty-hint">还没有记录</view>
      <view wx:for="{{history}}" wx:key="key" class="history-item">
        <text class="history-dates">{{item.dates}}</text>
        <text class="history-meta">{{item.meta}}</text>
      </view>
    </view>
  </block>

</view>
